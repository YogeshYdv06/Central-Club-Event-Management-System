rules_version = '2';

// Reference Firestore Security Rules for CampusConnect.
// Deploy via Firebase Console -> Firestore Database -> Rules (or `firebase deploy --only firestore:rules`).
//
// This project has NO Cloud Functions. RSVPs are handled entirely in the
// browser: one Firestore transaction creates/deletes
// events/{eventId}/rsvps/{uid} and moves events/{eventId}.rsvpCount by ±1 in
// the same commit. These rules are the server-side authority that keeps that
// pair honest and enforces event capacity atomically.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : "";
    }

    // Only Google sign-in is accepted. The domain check below proves the address
    // *looks* like a college address; this proves the address was actually
    // verified by Google. Without it, a password account created (by accident or
    // by an attacker) with an address such as "someone@mitsgwl.ac.in" would pass
    // the suffix test even though nobody proved they own that mailbox.
    function isGoogleAccount() {
      return isSignedIn()
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com';
    }

    function isCollegeUser() {
      return isGoogleAccount() && userEmail().matches('.*@mitsgwl\\.ac\\.in$');
    }

    function isAdmin() {
      return isGoogleAccount() && (
        userEmail() == '26ir1yo77@mitsgwl.ac.in' ||
        exists(/databases/$(database)/documents/organizers/$(userEmail()))
      );
    }

    // Organizers whitelist (readable by authenticated users to verify their own admin status)
    match /organizers/{email} {
      allow read: if isGoogleAccount() && (userEmail() == email || isAdmin());
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Student profiles & joinedClubs subcollection
    //
    // A student writes their own profile (the compulsory one-time form sets
    // studentProfileComplete: true). Admins may list the whole users
    // collection so the Student Directory can resolve names/year/branch for
    // club members and event participants.
    //
    // Field-level guard: a student cannot grant themselves admin powers on
    // their own document. (Admin status comes from organizers/{email}, so the
    // cosmetic `role` field stays writable — the dashboard sets it on every load.)
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isGoogleAccount() && (request.auth.uid == uid || isAdmin());
      allow create: if isCollegeUser()
        && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['isAdmin', 'permissions']);
      allow update: if isAdmin() || (
        isCollegeUser()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['isAdmin', 'permissions'])
      );
      allow delete: if isAdmin();

      match /joinedClubs/{clubId} {
        allow read: if isGoogleAccount() && (request.auth.uid == uid || isAdmin());
        allow write: if isAdmin();
      }

      match /certificates/{certId} {
        allow read: if isGoogleAccount() && (request.auth.uid == uid || isAdmin());
        allow write: if isAdmin();
      }
    }

    // ------------------------------------------------------------------
    // Events & RSVPs — capacity is enforced here, not in a Cloud Function
    //
    // Event documents carry a denormalised `rsvpCount` integer:
    //   rsvpCount === number of documents in events/{eventId}/rsvps
    //
    // A student never writes the RSVP collection on its own: the browser runs a
    // transaction that flips their RSVP document AND increments/decrements
    // `rsvpCount` together. getAfter()/existsAfter() let us prove — per commit —
    // that the two writes really happened together, so:
    //   • nobody can inflate rsvpCount to block other students,
    //   • nobody can create an RSVP without consuming a seat,
    //   • rsvpCount can never exceed `capacity` (0 = unlimited),
    //   • the sign-in email / uid on an RSVP document cannot be spoofed.
    // ------------------------------------------------------------------
    match /events/{eventId} {

      function myRsvpPath() {
        return /databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.uid);
      }

      function capacityOf(ev) {
        return ev.data.get('capacity', 0);
      }

      // The only non-admin write allowed on an event document: the counter, by
      // exactly one, in the same commit as the caller's own RSVP document
      // flipping the opposite way. Capacity is checked against the new count.
      // (Admins are included so an organizer outside the college domain can
      // still join/leave an event.)
      function pairedCounterWrite() {
        return (isCollegeUser() || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpCount'])
          && request.resource.data.rsvpCount is int
          && request.resource.data.rsvpCount >= 0
          && (
            // 1. Legacy event created before the counter existed: seed it once
            //    while joining, never above capacity. (Self-migrates on first RSVP.)
            (!resource.data.keys().hasAny(['rsvpCount'])
              && existsAfter(myRsvpPath())
              && (capacityOf(resource) == 0
                  || request.resource.data.rsvpCount <= capacityOf(resource)))
            // 2. Join: exactly +1, paired with a brand-new RSVP document,
            //    and only while a seat is still free.
            || (request.resource.data.rsvpCount == resource.data.get('rsvpCount', -1) + 1
                && existsAfter(myRsvpPath())
                && (capacityOf(resource) == 0
                    || request.resource.data.rsvpCount <= capacityOf(resource)))
            // 3. Leave: exactly -1, paired with the caller's RSVP being deleted.
            || (request.resource.data.rsvpCount == resource.data.get('rsvpCount', 1) - 1
                && !existsAfter(myRsvpPath()))
          );
      }

      allow read: if isCollegeUser() || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.location is string
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 0
        && request.resource.data.rsvpCount is int
        && request.resource.data.rsvpCount == 0
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isAdmin() && resource.data.createdBy == request.auth.uid)
        || pairedCounterWrite();
      allow delete: if isAdmin() && resource.data.createdBy == request.auth.uid;

      match /rsvps/{uid} {

        function eventBefore() {
          return get(/databases/$(database)/documents/events/$(eventId));
        }

        function eventAfter() {
          return getAfter(/databases/$(database)/documents/events/$(eventId));
        }

        // The seat is only claimed when the same commit also moves the counter.
        function counterMovedWithJoin() {
          return !eventBefore().data.keys().hasAny(['rsvpCount'])
            || eventAfter().data.get('rsvpCount', -1)
               == eventBefore().data.get('rsvpCount', -1) + 1;
        }

        function counterMovedWithLeave() {
          return !eventBefore().data.keys().hasAny(['rsvpCount'])
            || eventAfter().data.get('rsvpCount', 1)
               == eventBefore().data.get('rsvpCount', 1) - 1;
        }

        function seatsLeft() {
          return eventBefore().data.get('capacity', 0) == 0
            || eventBefore().data.get('rsvpCount', 0) + 1
               <= eventBefore().data.get('capacity', 0);
        }

        allow read: if isCollegeUser() || isAdmin();

        // Join: your own document, your own verified email, a free seat, and the
        // paired +1 on the parent event in the same transaction.
        allow create: if (isCollegeUser() || isAdmin())
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'photo', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == userEmail()
          && seatsLeft()
          && counterMovedWithJoin();

        allow update: if isAdmin();

        // Cancel: your own document, and the paired -1 on the parent event.
        // Admins can still remove any attendee (event cleanup / moderation).
        allow delete: if isAdmin()
          || (isCollegeUser()
              && uid == request.auth.uid
              && counterMovedWithLeave());
      }
    }

    // Collection group query for RSVPs.
    // Needed by the dashboard and the admin attendee lists.
    match /{path=**}/rsvps/{uid} {
      allow read: if isCollegeUser() || isAdmin();
    }

    // Collection group query for club members.
    // Required when an admin loads every club's member list at once
    // (Student Directory). Single-club reads are covered under /clubs below.
    match /{path=**}/members/{uid} {
      allow read: if isAdmin();
    }

    // Collection group query for issued student certificates (Admin Certificates page).
    match /{path=**}/certificates/{certId} {
      allow read: if isAdmin();
    }

    // Clubs, members, and joinRequests
    match /clubs/{clubId} {
      allow read: if isCollegeUser() || isAdmin();
      allow create, update, delete: if isAdmin();

      match /members/{uid} {
        allow read: if isCollegeUser() || isAdmin();
        allow write: if isAdmin();
      }

      match /joinRequests/{uid} {
        allow read: if isAdmin() || (isCollegeUser() && request.auth.uid == uid);
        allow create: if isCollegeUser()
          && request.auth.uid == uid
          && request.resource.data.userId == uid
          && request.resource.data.status == 'pending';
        allow update: if isAdmin();
        allow delete: if isAdmin() || (isCollegeUser() && request.auth.uid == uid);
      }
    }
  }
}
